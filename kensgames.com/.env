PORT=3000
NODE_ENV=development

# Session & JWT
SESSION_SECRET=manifold-session-secret-change-in-production
JWT_EXPIRY=24h

# Encryption (256-bit AES key = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SUBSTRATE_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Email Service (Nodemailer)
# In dev mode, emails are logged to console. Set real credentials for production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Configuration
EMAIL_FROM=noreply@kensgames.com
RECOVERY_LINK_BASE=http://localhost:3000/reset-password

# Password Recovery
RECOVERY_TOKEN_EXPIRY_MINUTES=15
